@page "/Cliente"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json

@inject HttpClient Http

<PageTitle>Clientes</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Clientes</h2>

        <button class="btn btn-primary" @onclick="NuevoCliente">
            <i class="bi bi-plus-circle"></i>
            Nuevo
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @mensaje

            <button type="button"
                    class="btn-close"
                    @onclick="LimpiarMensaje">
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @error

            <button type="button"
                    class="btn-close"
                    @onclick="LimpiarError">
            </button>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2">Cargando clientes...</p>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover table-bordered">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>CUI</th>
                        <th>NIT</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Fecha nacimiento</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var cliente in ClientesPaginados)
                    {
                        <tr>

                            <td>@cliente.Id_cliente</td>
                            <td>@cliente.CUI</td>
                            <td>@cliente.NIT</td>
                            <td>@cliente.Nombres</td>
                            <td>@cliente.Apellidos</td>
                            <td>@cliente.Direccion</td>
                            <td>@cliente.Telefono</td>

                            <td>
                                @(cliente.Fecha_Nacimiento?.ToString("dd/MM/yyyy"))
                            </td>

                            <td>
                                <div class="btn-group">

                                    <button class="btn btn-warning btn-sm"
                                            @onclick="() => EditarCliente(cliente)">
                                        Editar
                                    </button>

                                    <button class="btn btn-danger btn-sm"
                                            @onclick="() => EliminarCliente(cliente.Id_cliente)">
                                        Eliminar
                                    </button>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- PAGINACIÓN -->

        @if (TotalPaginas > 1)
        {
            <div class="d-flex justify-content-center mt-3">

                <nav>
                    <ul class="pagination">

                        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">

                            <button class="page-link"
                                    @onclick="PaginaAnterior">
                                Anterior
                            </button>

                        </li>

                        @for (int i = 1; i <= TotalPaginas; i++)
                        {
                            int pagina = i;

                            <li class="page-item @(paginaActual == pagina ? "active" : "")">

                                <button class="page-link"
                                        @onclick="() => CambiarPagina(pagina)">
                                    @pagina
                                </button>

                            </li>
                        }

                        <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">

                            <button class="page-link"
                                    @onclick="PaginaSiguiente">
                                Siguiente
                            </button>

                        </li>

                    </ul>
                </nav>

            </div>
        }
    }

</div>


<!-- ========================= -->
<!-- MODAL NUEVO / EDITAR -->
<!-- ========================= -->

@if (mostrarModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-lg">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        @(editando ? "Editar Cliente" : "Nuevo Cliente")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CerrarModal">
                    </button>

                </div>

                <EditForm Model="@clienteActual"
                          OnValidSubmit="GuardarCliente">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        <div class="row">

                            <!-- CUI -->
                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    CUI
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteActual.CUI" />

                                <ValidationMessage For="@(() => clienteActual.CUI)" />

                            </div>


                            <!-- NIT -->
                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    NIT
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteActual.NIT" />

                                <ValidationMessage For="@(() => clienteActual.NIT)" />

                            </div>


                            <!-- Nombres -->
                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Nombres *
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteActual.Nombres" />

                                <ValidationMessage For="@(() => clienteActual.Nombres)" />

                            </div>


                            <!-- Apellidos -->
                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Apellidos *
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteActual.Apellidos" />

                                <ValidationMessage For="@(() => clienteActual.Apellidos)" />

                            </div>


                            <!-- Dirección -->
                            <div class="col-md-12 mb-3">

                                <label class="form-label">
                                    Dirección
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteActual.Direccion" />

                                <ValidationMessage For="@(() => clienteActual.Direccion)" />

                            </div>


                            <!-- Teléfono -->
                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Teléfono
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteActual.Telefono" />

                                <ValidationMessage For="@(() => clienteActual.Telefono)" />

                            </div>


                            <!-- Fecha -->
                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Fecha de nacimiento
                                </label>

                                <InputDate class="form-control"
                                           @bind-Value="clienteActual.Fecha_Nacimiento" />

                                <ValidationMessage For="@(() => clienteActual.Fecha_Nacimiento)" />

                            </div>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CerrarModal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            @(editando ? "Actualizar" : "Guardar")
                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>
}


@code {

    // =========================
    // VARIABLES
    // =========================

    private List<ClienteDto> clientes = new();

    private ClienteDto clienteActual = new();

    private bool mostrarModal = false;

    private bool editando = false;

    private bool cargando = true;

    private string mensaje = "";

    private string error = "";


    // =========================
    // PAGINACIÓN
    // =========================

    private int paginaActual = 1;

    private int elementosPorPagina = 5;


    private int TotalPaginas =>
        clientes.Count == 0
            ? 1
            : (int)Math.Ceiling(
                clientes.Count / (double)elementosPorPagina
            );


    private IEnumerable<ClienteDto> ClientesPaginados =>
        clientes
            .Skip((paginaActual - 1) * elementosPorPagina)
            .Take(elementosPorPagina);


    // =========================
    // CARGAR CLIENTES
    // =========================

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }


    private async Task CargarClientes()
    {
        try
        {
            cargando = true;
            error = "";

            var resultado =
                await Http.GetFromJsonAsync<List<ClienteDto>>(
                    "api/Clientes"
                );

            clientes = resultado ?? new List<ClienteDto>();

            if (paginaActual > TotalPaginas)
            {
                paginaActual = TotalPaginas;
            }
        }
        catch (Exception ex)
        {
            error = $"Error al cargar los clientes: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    // =========================
    // NUEVO CLIENTE
    // =========================

    private void NuevoCliente()
    {
        clienteActual = new ClienteDto();

        editando = false;

        mostrarModal = true;

        LimpiarMensajes();
    }


    // =========================
    // EDITAR CLIENTE
    // =========================

    private void EditarCliente(ClienteDto cliente)
    {
        clienteActual = new ClienteDto
        {
            Id_cliente = cliente.Id_cliente,
            CUI = cliente.CUI,
            NIT = cliente.NIT,
            Nombres = cliente.Nombres,
            Apellidos = cliente.Apellidos,
            Direccion = cliente.Direccion,
            Telefono = cliente.Telefono,
            Fecha_Nacimiento = cliente.Fecha_Nacimiento
        };

        editando = true;

        mostrarModal = true;

        LimpiarMensajes();
    }


    // =========================
    // GUARDAR / ACTUALIZAR
    // =========================

    private async Task GuardarCliente()
    {
        try
        {
            error = "";
            mensaje = "";

            HttpResponseMessage respuesta;

            if (editando)
            {
                respuesta = await Http.PutAsJsonAsync(
                    $"api/Clientes/{clienteActual.Id_cliente}",
                    clienteActual
                );
            }
            else
            {
                respuesta = await Http.PostAsJsonAsync(
                    "api/Clientes",
                    clienteActual
                );
            }

            if (respuesta.IsSuccessStatusCode)
            {
                mostrarModal = false;

                mensaje = editando
                    ? "Cliente actualizado correctamente."
                    : "Cliente creado correctamente.";

                await CargarClientes();
            }
            else
            {
                error =
                    $"No se pudo guardar el cliente. Código: {respuesta.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            error = $"Error al guardar: {ex.Message}";
        }
    }


    // =========================
    // ELIMINAR
    // =========================

    private async Task EliminarCliente(int id)
    {
        try
        {
            error = "";
            mensaje = "";

            var respuesta =
                await Http.DeleteAsync(
                    $"api/Clientes/{id}"
                );

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Cliente eliminado correctamente.";

                await CargarClientes();
            }
            else
            {
                error =
                    $"No se pudo eliminar el cliente. Código: {respuesta.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            error = $"Error al eliminar: {ex.Message}";
        }
    }


    // =========================
    // MODAL
    // =========================

    private void CerrarModal()
    {
        mostrarModal = false;
    }


    // =========================
    // PAGINACIÓN
    // =========================

    private void CambiarPagina(int pagina)
    {
        if (pagina >= 1 && pagina <= TotalPaginas)
        {
            paginaActual = pagina;
        }
    }


    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
        }
    }


    private void PaginaSiguiente()
    {
        if (paginaActual < TotalPaginas)
        {
            paginaActual++;
        }
    }


    // =========================
    // MENSAJES
    // =========================

    private void LimpiarMensajes()
    {
        mensaje = "";
        error = "";
    }


    private void LimpiarMensaje()
    {
        mensaje = "";
    }


    private void LimpiarError()
    {
        error = "";
    }


    // =========================
    // DTO
    // =========================

    public class ClienteDto
    {
        public int Id_cliente { get; set; }

        public string? CUI { get; set; }

        public string? NIT { get; set; }

        [Required(ErrorMessage = "El nombre es obligatorio.")]
        public string? Nombres { get; set; }

        [Required(ErrorMessage = "El apellido es obligatorio.")]
        public string? Apellidos { get; set; }

        public string? Direccion { get; set; }

        public string? Telefono { get; set; }

        public DateTime? Fecha_Nacimiento { get; set; }
    }
}